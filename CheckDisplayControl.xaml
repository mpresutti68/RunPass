<UserControl x:Class="RunPass.CheckDisplayControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="380" Height="550" Background="#1E1E1E">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Testata -->
        <Border Grid.Row="0" Background="#2D2D30" Padding="12" CornerRadius="4" Margin="0,0,0,10">
            <TextBlock Text="CONTO CORRENTE" Foreground="#FFFFFF" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
        </Border>

        <!-- Lista Articoli con DataBinding -->
        <ListBox Grid.Row="1" ItemsSource="{Binding Items}" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="#333333" BorderThickness="0,0,0,1" Padding="8,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="{Binding Quantity, StringFormat='{}{0}x '}" Foreground="#888888" FontSize="16" FontWeight="Bold"/>
                            <TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="#FFFFFF" FontSize="16" Margin="5,0,0,0" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Grid.Column="2" Text="{Binding Price, StringFormat='{}{0:C2}'}" Foreground="#FFFFFF" FontSize="16" FontWeight="SemiBold"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Totale Conto -->
        <Border Grid.Row="2" Background="#252526" Padding="15" CornerRadius="4" Margin="0,10,0,0">
            <Grid>
                <TextBlock Text="TOTALE" Foreground="#AAAAAA" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding TotalAmount, StringFormat='{}{0:C2}'}" Foreground="#4CAF50" FontSize="26" FontWeight="Bold" HorizontalAlignment="Right"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
